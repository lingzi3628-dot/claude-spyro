{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    // Source maps embed the original TypeScript. Shipped builds must never
    // include them, or the package is effectively open source.
    "sourceMap": false
  },
  "include": ["src/**/*.ts"]
}
